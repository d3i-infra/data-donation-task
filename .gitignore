*.whl
*.pyc

/packages/*/dist
/packages/*/build
/packages/*/node_modules

# dependencies
/node_modules
/.pnp
.pnp.js

# pnpm
.pnpm-debug.log*

# testing
/coverage

# Real DDP fixtures — must not enter version control (see ADR-0014)
packages/python/tests/ddp/*
!packages/python/tests/ddp/.gitkeep

# production
/build
/releases

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/public/port-0.0.0-py3-none-any.whl
/src/framework/processing/py/dist/port-0.0.0-py3-none-any.whl

# Worktrees
.worktrees/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Act artifacts
.artifacts/
release-for-website.sh

_build
doc/build

# In-project virtualenv. packages/python/.venv is provisioned per machine (dev:
# `poetry install`; the VM: the deployment repo's sync unit) so that a `cp -r`
# copy of the checkout carries a working environment for release.sh's config
# validation. It is machine-local state, never committed or shipped. Matches at
# any depth, so packages/python/.venv is covered too.
.venv/

# Ignore all __pycache__ directories
__pycache__/
*/__pycache__/
**/__pycache__/
*.egg-info

# Also ignore Python compiled files
*.py[cod]
*$py.class
release-for-website.sh

structure_donations/Processed_structure_donations/TikTok/Raw
structure_donations/Processed_structure_donations/Facebook/Raw
structure_donations/Processed_structure_donations/Instagram/Raw
structure_donations/Processed_structure_donations/Youtube/Raw
structure_donations/Processed_structure_donations/Twitter/Raw

structure_donations/Processed_structure_donations/TikTok/Input_test
structure_donations/Processed_structure_donations/Facebook/Input_test
structure_donations/Processed_structure_donations/Instagram/Input_test
structure_donations/Processed_structure_donations/Youtube/Input_test
structure_donations/Processed_structure_donations/Twitter/Input_test

/pytests/private_testfiles
pytests/scenarios/*PRIVATE.json

.~lock.*#

# Config files (keep example configs)
*_config.json
!*example_config.json

# Claude Code: track shared settings.json only — local overrides and agent
# worktrees stay personal
.claude/settings.local.json
.claude/worktrees/
docs/notes/

# husky runtime internals (regenerated by `husky install`)
.husky/_
